{
  "name": "@qiuxy/dsh-provider-label",
  "version": "1.0.1",
  "description": "Show which provider a model comes from in the DeepSeek Harness model chip — works even when another plugin owns the label slot. · 在 DeepSeek Harness 的模型按钮上显示模型来自哪个供应商，即使标签槽已被其它插件占用也有效。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "icon.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "model",
    "provider",
    "ui",
    "model-selector"
  ],
  "license": "MIT",
  "author": "tanqvvv",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanqvv/dsh-provider-label.git"
  },
  "homepage": "https://github.com/tanqvv/dsh-provider-label",
  "bugs": {
    "url": "https://github.com/tanqvv/dsh-provider-label/issues"
  },
  "engines": {
    "dsh": ">=0.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
